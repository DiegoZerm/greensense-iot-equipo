# Copiar a infra/.env y cambiar las contraseñas. infra/.env no se sube al repo.

# Base de datos
DB_HOST=localhost
DB_PUERTO=5432
DB_NOMBRE=greensense
DB_USUARIO=greensense
DB_CONTRASENA=cambiar

# MQTT
MQTT_HOST=localhost
MQTT_PUERTO=1883
MQTT_USUARIO_SERVIDOR=servidor
MQTT_CONTRASENA_SERVIDOR=cambiar

# Usuarios de los nodos, separados por espacios: <nodo>:<contraseña>
# El usuario MQTT de cada nodo es su identificador.
MQTT_NODOS="nodo1:cambiar"

# Notificaciones push. Generar con: servidor/.venv/bin/greensense vapid
VAPID_PRIVADA=
VAPID_PUBLICA=
VAPID_CONTACTO=mailto:admin@greensense.local

# Sesiones (JWT). Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Si se deja vacío, el servidor genera uno al arrancar y las sesiones se pierden al reiniciar.
JWT_SECRETO=
SESION_HORAS=12

# Administrador que se crea al arrancar si la base no tiene usuarios. Después de entrar,
# cambiar la contraseña desde la app y borrar estas dos líneas.
ADMIN_CORREO=admin@greensense.local
ADMIN_CONTRASENA=cambiar-esta-contrasena
